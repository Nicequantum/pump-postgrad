# Copy to .env and fill in values
POSTGRAD_WALLET=your_bs58_private_key_here
QUERY_RPC=https://your-rpc.example.com
SEND_RPC=https://your-rpc.example.com
SOLANA_RPC_TOKEN=
SHREDSTREAM_AUTH_TOKEN=your_shredstream_token
SHREDSTREAM_GRPC_URL=https://solana-shredstream-grpc.rpcfast.com:443
JUPITER_API_KEY=
DRY_RUN=true
POSTGRAD_BUY_SOL_LAMPORTS=50000000
POSTGRAD_TAKE_PROFIT_PCT=25
POSTGRAD_STOP_LOSS_PCT=12
POSTGRAD_MAX_HOLD_SECS=90